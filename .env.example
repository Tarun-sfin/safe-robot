# Copy to .env and adjust. Never commit .env.

# Front-end base (Angular app is served under /apply/)
APP_BASE_URL=https://beta2.safefinancial.com.au

# Exact Postman URL for injecting a bank statement
STATEMENT_POST_URL=https://safe-api-beta.azurewebsites.net/bank-feed/submission-response

# Reference prefix used in statement JSON: customer.reference = "{PREFIX}-{code}"
# Beta OnlineAppCode is SFPM (see banksettings.beta.json). Live may differ (SAFE / SFST).
BANK_REFERENCE_PREFIX=SFPM

# Path to your real bank-statement JSON (the Postman body). Relative to playwright-tests/.
STATEMENT_FILE=fixtures/bank-statement.json

# Start URL path under the app
START_PATH=/apply/mini-loan

# 1 = pause in headed browser after capturing verification code (you can Postman manually)
PAUSE_AT_BANK=0

# 1 = after injecting statement, keep clicking through budget → submit
CONTINUE_TO_SUBMIT=1
